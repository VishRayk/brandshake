# Core API
BRANDSHAKE_ENV=development
BRANDSHAKE_ADDR=:8080
BRANDSHAKE_DATABASE_URL=postgres://brandshake:brandshake@localhost:5432/brandshake?sslmode=disable
# Required outside development (32+ characters)
BRANDSHAKE_JWT_SECRET=
BRANDSHAKE_ACCESS_TOKEN_TTL=24h
BRANDSHAKE_ALLOWED_ORIGINS=http://localhost:5173

# AI service: "fake" runs offline; "gemini" calls the Gemini API
BRANDSHAKE_AI_PROVIDER=fake
GEMINI_API_KEY=
BRANDSHAKE_AI_GEMINI_MODEL_FAST=
BRANDSHAKE_AI_GEMINI_MODEL_SMART=
BRANDSHAKE_AI_REQUESTS_PER_MINUTE=10
